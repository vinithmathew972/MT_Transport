# Mother Theresa Transport Management System - Environment Configuration
APP_NAME="Mother Theresa Transport"
APP_TAGLINE="Safe Journey... Stronger Tomorrow..."
ENVIRONMENT="development"

# Server Host and Port
HOST="127.0.0.1"
PORT=8000

# Secret Key for JWT Authentication (generate a secure 32+ char key in production)
SECRET_KEY="generate-a-strong-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Fallback local SQLite: sqlite:///./transport.db
# Production PostgreSQL example: postgresql://postgres:your_password@localhost:5432/mother_theresa_transport
DATABASE_URL="sqlite:///./transport.db"

# Initial Secure Owner Setup
DEFAULT_OWNER_USERNAME="owner"
DEFAULT_OWNER_PASSWORD="change_this_secure_password_on_first_login"
DEFAULT_OWNER_NAME="Transport Owner"
